root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# В markdown два пробела в конце строки — это перенос строки
[*.md]
trim_trailing_whitespace = false

# Данные пишут генераторы, со своей шириной отступа
[data/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset

# Эталонные векторы пишет генератор одной строкой, lock-файл пишет pnpm
[*.json]
indent_style = unset
indent_size = unset
insert_final_newline = unset

[pnpm-lock.yaml]
indent_size = unset
