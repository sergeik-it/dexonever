pragma tvm-solidity >= 0.79.0;

/**
 * @title Burn callback
 * @notice Callback the TokenRoot sends to `callbackTo` after it has accepted a burn.
 *
 * Chains of calls:
 *  1) walletOwner -> IBurnableTokenWallet(wallet).burn(...) ->
 *                    ITokenRoot(root).burn_notification(...) ->
 *                    IAcceptTokensBurnCallback(callbackTo).onAcceptTokensBurn(...)
 *  2) rootOwner -> IBurnableByRootTokenRoot(root).burnTokens(...) ->
 *                  IBurnableByRootTokenWallet(wallet).burnByRoot(...) ->
 *                  ITokenRoot(root).burn_notification(...) ->
 *                  IAcceptTokensBurnCallback(callbackTo).onAcceptTokensBurn(...)
 */
interface IAcceptTokensBurnCallback {

    /**
     * @notice Called by the TokenRoot after the tokens are burnt and the total supply is decreased.
     * @param amount The amount of tokens burnt.
     * @param walletOwner The owner of the token wallet whose tokens were burnt.
     * @param wallet The token wallet whose tokens were burnt.
     * @param remainingGasTo The address that should receive the remaining gas.
     * @param payload Additional data attached to the burn.
    */
    function onAcceptTokensBurn(
        uint128 amount,
        address walletOwner,
        address wallet,
        address remainingGasTo,
        TvmCell payload
    ) external;
}