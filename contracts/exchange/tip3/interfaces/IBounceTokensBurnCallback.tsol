pragma tvm-solidity >= 0.79.0;

/**
 * @title Burn bounce callback
 * @notice Callback a token wallet sends to its owner when the TokenRoot rejects a burn
 * and the tokens are returned to the wallet balance.
 *
 * Chain of calls:
 *
 * walletOwner -> IBurnableTokenWallet(wallet).burn(...) ->
 *                ITokenRoot(root).burn_notification(...) (bounced) ->
 *                TokenWalletBase.onBounce(...) ->
 *                IBounceTokensBurnCallback(walletOwner).onBounceTokensBurn(...)
 */
interface IBounceTokensBurnCallback {

    /**
     * @notice Called by the token wallet when a burn is reverted.
     * @param tokenRoot The TokenRoot of the wallet.
     * @param amount The amount of tokens returned to the balance.
    */
    function onBounceTokensBurn(
        address tokenRoot,
        uint128 amount
    ) external;
}
